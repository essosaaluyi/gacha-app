# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.tmp-spreadsheet-build/
.tmp-*/
/tmp/
/output/
/outputs/

# claude tooling worktrees + local temp
.claude/worktrees/

# Local video tools and Python caches
/.codex/video-tools/
__pycache__/
*.py[cod]

# Local-only editable production artwork / project files
*.psd
*.psb
*.ai
*.blend
*.blend1
*.c4d
*.aep
*.prproj
*.kra
*.clip
*.xcf
